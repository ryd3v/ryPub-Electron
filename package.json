{
  "name": "rypub",
  "author": "Ryan Collins <hello@ryd3v.com>",
  "copyright": "© 2024 ryd3v",
  "homepage": "https://ryd3v.com",
  "version": "2.0.12",
  "description": "ryPub Simple ePub Reader",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-builder",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "build": {
    "appId": "com.ryd3v.rypub",
    "directories": {
      "output": "build"
    },
    "linux": {
      "category": "Office",
      "icon": "src/images/book.png",
      "target": [
        "deb"
      ]
    },
    "win": {
      "target": "nsis",
      "publisherName": "Ryan Collins",
      "icon": "src/images/book.ico"
    }
  },
  "dependencies": {
    "epub": "^2.1.1",
    "epubjs": "^0.3.93"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "xml2js": "^0.6.2"
  }
}
